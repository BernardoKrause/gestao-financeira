<h1 class="mb-3">Categorias</h1>
<%= link_to "Nova categoria", new_category_path, class: "btn btn-primary mb-3" %>
<div class="list-group">
  <% @categories.each do |category| %>
    <div class="list-group-item d-flex justify-content-between align-items-center">
      <div>
        <%= link_to category.name, category_path(category) %>
        <span class="text-muted">(<%= category.kind %>)</span>
      </div>
      <div>
        <%= link_to "Editar", edit_category_path(category), class: "btn btn-sm btn-outline-secondary" %>
        <%= link_to "Remover", category_path(category), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "btn btn-sm btn-outline-danger" %>
      </div>
    </div>
  <% end %>
</div>

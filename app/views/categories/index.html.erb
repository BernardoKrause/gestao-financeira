<h1 class="mb-3">Categorias</h1>
<%= link_to "Nova categoria", new_category_path, class: "btn btn-primary mb-3" %>

<table class="table table-striped bg-white align-middle">
  <thead>
    <tr>
      <th>Nome</th>
      <th>Tipo</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= link_to category.name, category_path(category) %></td>
        <td>
          <span class="badge <%= category.expense? ? 'bg-danger' : 'bg-success' %>">
            <%= category.expense? ? "Gasto" : "Receita" %>
          </span>
        </td>
        <td class="text-end">
          <%= link_to "Editar", edit_category_path(category), class: "btn btn-sm btn-outline-secondary" %>
          <%= link_to "Remover", category_path(category), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "btn btn-sm btn-outline-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<h1 class="mb-4 text-2xl font-bold">Categorias</h1>
<%= link_to "Nova categoria", new_category_path, class: "mb-4 inline-block rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>

<div class="grid gap-3 md:hidden" data-testid="categories-cards">
  <% @categories.each do |category| %>
    <%= render "category_row", category: category, format: :card %>
  <% end %>
</div>

<table class="hidden w-full bg-white text-sm md:table" data-testid="categories-table">
  <thead>
    <tr>
      <th class="border px-3 py-2 text-left">Nome</th>
      <th class="border px-3 py-2 text-left">Tipo</th>
      <th class="border px-3 py-2 text-left"></th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <%= render "category_row", category: category, format: :table %>
    <% end %>
  </tbody>
</table>

<% workout_program = local_assigns[:workout_program]
   program_day = local_assigns[:program_day] %>
<%= form_with model: exercise,
      url: exercise.persisted? ? exercise_path(exercise) : exercises_path(workout_program_id: workout_program&.id, program_day_id: program_day&.id) do |f| %>
  <div class="mb-4">
    <%= f.label :name, "Nome", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div class="mb-4">
    <%= f.label :muscle_group, "Grupo muscular", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.select :muscle_group, options_for_select(Exercise::MUSCLE_GROUP_LABELS.map { |k, v| [ v, k ] }, exercise.muscle_group), {}, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div class="mb-4">
    <%= f.label :kind, "Tipo", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.select :kind, options_for_select(Exercise::KIND_LABELS.map { |k, v| [ v, k ] }, exercise.kind), {}, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <div class="mb-4">
    <%= f.label :notes, "Notas (regulagem, execução...)", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_area :notes, rows: 3, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm" %>
  </div>
  <%= f.submit class: "rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
<% end %>

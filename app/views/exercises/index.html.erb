<h1 class="mb-4 text-2xl font-bold">Biblioteca de Exercícios</h1>

<% if @workout_program %>
  <%= link_to "← Voltar para a ficha", edit_workout_program_path(@workout_program), class: "mb-4 inline-block text-sm text-blue-600 hover:text-blue-700" %>
<% end %>

<%= link_to "+ Criar Exercício", new_exercise_path(workout_program_id: @workout_program&.id, program_day_id: @program_day&.id), class: "mb-4 inline-block rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>

<%= form_with url: exercises_path(workout_program_id: @workout_program&.id, program_day_id: @program_day&.id), method: :get,
      class: "mb-4 flex flex-wrap gap-2",
      data: { controller: "exercises-filter", exercises_filter_url_value: exercises_path(workout_program_id: @workout_program&.id, program_day_id: @program_day&.id) } do %>
  <%= select_tag :muscle_group, options_for_select([ [ "Todos os grupos", "" ] ] + Exercise::MUSCLE_GROUP_LABELS.map { |k, v| [ v, k ] }, params[:muscle_group]), class: "rounded border border-gray-300 px-3 py-2 text-sm", data: { action: "change->exercises-filter#filterNow" } %>
  <%= select_tag :kind, options_for_select([ [ "Todos os tipos", "" ] ] + Exercise::KIND_LABELS.map { |k, v| [ v, k ] }, params[:kind]), class: "rounded border border-gray-300 px-3 py-2 text-sm", data: { action: "change->exercises-filter#filterNow" } %>
  <%= text_field_tag :query, params[:query], placeholder: "Buscar por nome", class: "rounded border border-gray-300 px-3 py-2 text-sm", data: { action: "input->exercises-filter#filterDebounced" } %>
<% end %>

<div id="exercises-list">
  <%= render "exercises_list", exercises: @exercises, workout_program: @workout_program, program_day: @program_day, added_exercise_ids: @added_exercise_ids %>
</div>

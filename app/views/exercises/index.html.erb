<h1 class="mb-4 text-2xl font-bold">Biblioteca de Exercícios</h1>
<%= link_to "+ Criar Exercício", new_exercise_path, class: "mb-4 inline-block rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>

<%= form_with url: exercises_path, method: :get, class: "mb-4 flex flex-wrap gap-2" do %>
  <%= select_tag :muscle_group, options_for_select([ [ "Todos os grupos", "" ] ] + Exercise::MUSCLE_GROUP_LABELS.map { |k, v| [ v, k ] }, params[:muscle_group]), class: "rounded border border-gray-300 px-3 py-2 text-sm" %>
  <%= select_tag :kind, options_for_select([ [ "Todos os tipos", "" ] ] + Exercise::KIND_LABELS.map { |k, v| [ v, k ] }, params[:kind]), class: "rounded border border-gray-300 px-3 py-2 text-sm" %>
  <%= text_field_tag :query, params[:query], placeholder: "Buscar por nome", class: "rounded border border-gray-300 px-3 py-2 text-sm" %>
  <%= submit_tag "Filtrar", class: "rounded border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
<% end %>

<div class="grid gap-3 md:hidden" data-testid="exercises-cards">
  <% @exercises.each do |exercise| %>
    <%= render "exercise_row", exercise: exercise, format: :card %>
  <% end %>
</div>

<table class="hidden w-full bg-white text-sm md:table" data-testid="exercises-table">
  <thead>
    <tr>
      <th class="border px-3 py-2 text-left">Nome</th>
      <th class="border px-3 py-2 text-left">Grupo</th>
      <th class="border px-3 py-2 text-left">Tipo</th>
      <th class="border px-3 py-2 text-left"></th>
    </tr>
  </thead>
  <tbody>
    <% @exercises.each do |exercise| %>
      <%= render "exercise_row", exercise: exercise, format: :table %>
    <% end %>
  </tbody>
</table>

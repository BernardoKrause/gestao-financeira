<% if format == :table %>
  <tr>
    <td class="border px-3 py-2"><%= exercise.name %></td>
    <td class="border px-3 py-2"><%= Exercise::MUSCLE_GROUP_LABELS[exercise.muscle_group] %></td>
    <td class="border px-3 py-2"><%= Exercise::KIND_LABELS[exercise.kind] %></td>
    <td class="border px-3 py-2 text-right">
      <% if exercise.global? %>
        <span class="text-xs text-gray-400">Catálogo</span>
      <% else %>
        <%= link_to "Editar", edit_exercise_path(exercise), class: "rounded border border-gray-300 px-2 py-1 text-xs text-gray-700 hover:bg-gray-50" %>
        <%= link_to "Remover", exercise_path(exercise), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "rounded border border-red-300 px-2 py-1 text-xs text-red-600 hover:bg-red-50" %>
      <% end %>
    </td>
  </tr>
<% else %>
  <div class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
    <div class="flex items-center justify-between gap-2">
      <span class="font-semibold text-gray-900"><%= exercise.name %></span>
      <span class="rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700"><%= Exercise::MUSCLE_GROUP_LABELS[exercise.muscle_group] %></span>
    </div>
    <p class="mt-1 text-xs text-gray-500"><%= Exercise::KIND_LABELS[exercise.kind] %></p>
    <% unless exercise.global? %>
      <div class="mt-3 flex gap-3">
        <%= link_to "Editar", edit_exercise_path(exercise), class: "rounded border border-gray-300 px-2 py-1 text-xs text-gray-700 hover:bg-gray-50" %>
        <%= link_to "Remover", exercise_path(exercise), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "rounded border border-red-300 px-2 py-1 text-xs text-red-600 hover:bg-red-50" %>
      </div>
    <% end %>
  </div>
<% end %>

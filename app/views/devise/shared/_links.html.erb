<div class="mt-6 flex flex-col items-center gap-2 text-sm">
  <% if controller_name != "sessions" %>
    <%= link_to "Entrar", new_session_path(resource_name), class: "text-gray-500 hover:text-indigo-600" %>
  <% end %>

  <% if controller_name != "registrations" %>
    <%= link_to "Criar conta", new_registration_path(resource_name), class: "text-gray-500 hover:text-indigo-600" %>
  <% end %>

  <% if controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-gray-500 hover:text-indigo-600" %>
  <% end %>
</div>

<h1 class="mb-4 text-2xl font-bold">Fichas de Treino</h1>

<% if @workout_streak.trackable? %>
  <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4">
    <% if @workout_streak.current_streak_weeks.positive? %>
      <p class="text-lg font-semibold text-gray-900">
        🔥 <%= @workout_streak.current_streak_weeks %> <%= @workout_streak.current_streak_weeks == 1 ? "semana seguida" : "semanas seguidas" %>
      </p>
    <% else %>
      <p class="text-lg font-semibold text-gray-900">Comece sua sequência!</p>
    <% end %>
    <p class="mt-1 text-sm text-gray-600">Esta semana: <%= @workout_streak.current_week_count %>/<%= @workout_streak.weekly_goal %> treinos</p>

    <% if @workout_streak.unlocked_badges.any? %>
      <div class="mt-3 flex flex-wrap gap-2">
        <% @workout_streak.unlocked_badges.each do |milestone| %>
          <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-800">🏅 <%= milestone %> semanas</span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<% if @active_workout_program %>
  <div class="mb-6 rounded-lg border border-blue-200 bg-blue-50 p-4">
    <p class="text-xs font-medium uppercase tracking-wide text-blue-600">Ficha ativa</p>
    <p class="mt-1 text-lg font-semibold text-gray-900"><%= @active_workout_program.name %></p>
    <% if @active_workout_program.program_days.any? %>
      <%= button_to "Iniciar Treino", workout_session_path, class: "mt-3 inline-block rounded bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700" %>
    <% end %>
  </div>
<% end %>

<%= link_to "+ Nova Ficha", new_workout_program_path, class: "mb-4 inline-block rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>

<div class="mt-4 space-y-3" data-testid="workout-programs-list">
  <% @workout_programs.each do |workout_program| %>
    <%= render "workout_program_row", workout_program: workout_program %>
  <% end %>
</div>

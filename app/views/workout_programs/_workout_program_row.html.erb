<div class="rounded-lg border border-gray-200 bg-white p-4 text-sm" data-testid="workout-program-<%= workout_program.id %>">
  <div class="flex items-center justify-between gap-2">
    <span class="font-semibold text-gray-900"><%= workout_program.name %></span>
    <% if workout_program.active? %>
      <span class="rounded-full bg-green-100 px-2 py-1 text-xs font-medium text-green-700">Ativa</span>
    <% end %>
  </div>
  <div class="mt-3 flex flex-wrap gap-3">
    <% unless workout_program.active? %>
      <%= button_to "Alternar para esta Ficha", activate_workout_program_path(workout_program), class: "rounded bg-blue-600 px-2 py-1 text-xs font-medium text-white hover:bg-blue-700" %>
    <% end %>
    <%= link_to "Editar", edit_workout_program_path(workout_program), class: "rounded border border-gray-300 px-2 py-1 text-xs text-gray-700 hover:bg-gray-50" %>
    <%= button_to "Duplicar", duplicate_workout_program_path(workout_program), class: "rounded border border-gray-300 px-2 py-1 text-xs text-gray-700 hover:bg-gray-50" %>
    <%= link_to "Remover", workout_program_path(workout_program), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "rounded border border-red-300 px-2 py-1 text-xs text-red-600 hover:bg-red-50" %>
  </div>
</div>

<h1 class="mb-4 text-2xl font-bold">Iniciar Treino</h1>
<p class="mb-4 text-sm text-gray-600">Ficha: <strong><%= @workout_program.name %></strong></p>

<%= form_with url: workout_session_path, method: :post do %>
  <div class="space-y-2">
    <% @program_days.each do |day| %>
      <label class="flex items-center gap-2 rounded border border-gray-200 bg-white p-3 text-sm">
        <%= radio_button_tag :program_day_id, day.id, day == @suggested_program_day %>
        <span class="font-medium">Treino <%= day.label %></span>
        <span class="text-gray-500"><%= day.title %></span>
        <% if day == @suggested_program_day %>
          <span class="ml-auto rounded-full bg-blue-100 px-2 py-1 text-xs font-medium text-blue-700">Sugerido</span>
        <% end %>
      </label>
    <% end %>
  </div>

  <%= submit_tag "Começar", class: "mt-4 rounded bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700" %>
<% end %>

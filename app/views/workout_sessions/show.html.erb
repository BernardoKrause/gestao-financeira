<div class="mb-4 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Treino <%= @workout_session.program_day.label %> — <%= @workout_session.program_day.title %></h1>
  <%= button_to "Cancelar treino", workout_session_path, method: :delete, data: { turbo_confirm: "Tem certeza? Isso vai descartar todo o progresso deste treino." }, class: "rounded border border-red-300 px-3 py-1 text-xs text-red-600 hover:bg-red-50" %>
</div>

<div class="space-y-6 pb-24" data-testid="session-exercises">
  <% @program_exercises.each do |program_exercise| %>
    <div class="rounded-lg border border-gray-200 bg-white p-4" data-testid="session-exercise-<%= program_exercise.id %>">
      <div class="flex items-center justify-between gap-2">
        <span class="font-semibold text-gray-900"><%= program_exercise.exercise.name %></span>
        <span class="rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700"><%= Exercise::MUSCLE_GROUP_LABELS[program_exercise.exercise.muscle_group] %></span>
      </div>

      <div class="mt-3 space-y-2">
        <% (@set_logs_by_program_exercise[program_exercise.id] || []).each do |set_log| %>
          <%= render "set_logs/set_log_row", set_log: set_log %>
        <% end %>
      </div>

      <%= button_to "+ Adicionar Série", workout_session_set_logs_path(program_exercise_id: program_exercise.id), class: "mt-3 text-sm font-medium text-blue-600 hover:text-blue-700" %>
    </div>
  <% end %>
</div>

<div class="fixed inset-x-0 bottom-0 border-t border-gray-200 bg-white p-4">
  <div class="mx-auto max-w-5xl">
    <%= button_to "Finalizar Treino", finish_workout_session_path, method: :patch, class: "w-full rounded bg-blue-600 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-blue-700" %>
  </div>
</div>

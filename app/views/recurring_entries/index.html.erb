<h1 class="mb-3">Gastos e receitas fixas</h1>
<%= link_to "Nova recorrência", new_recurring_entry_path, class: "btn btn-primary mb-3" %>

<table class="table table-striped bg-white align-middle">
  <thead>
    <tr>
      <th>Descrição</th>
      <th>Dia</th>
      <th>Tipo</th>
      <th>Valor</th>
      <th>Categoria</th>
      <th>Status</th>
      <th>Até</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @recurring_entries.each do |entry| %>
      <tr>
        <td><%= entry.description %></td>
        <td><%= entry.day_of_month %></td>
        <td>
          <span class="badge <%= entry.expense? ? 'bg-danger' : 'bg-success' %>">
            <%= entry.expense? ? "Gasto" : "Receita" %>
          </span>
        </td>
        <td class="<%= entry.expense? ? 'text-danger' : 'text-success' %> fw-semibold">
          <%= number_to_currency(entry.amount, unit: "R$ ") %>
        </td>
        <td><%= entry.category.name %></td>
        <td>
          <span class="badge <%= entry.active? ? 'bg-success' : 'bg-secondary' %>">
            <%= entry.active? ? "Ativa" : "Inativa" %>
          </span>
        </td>
        <td><%= entry.end_date || "Sem fim" %></td>
        <td class="text-end">
          <%= link_to "Editar", edit_recurring_entry_path(entry), class: "btn btn-sm btn-outline-secondary" %>
          <%= link_to "Remover", recurring_entry_path(entry), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "btn btn-sm btn-outline-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

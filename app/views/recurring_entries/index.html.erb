<h1 class="mb-3">Gastos e receitas fixas</h1>
<%= link_to "Nova recorrência", new_recurring_entry_path, class: "btn btn-primary mb-3" %>
<div class="list-group">
  <% @recurring_entries.each do |entry| %>
    <div class="list-group-item d-flex justify-content-between align-items-center">
      <div>
        <%= entry.description %> — dia <%= entry.day_of_month %> —
        <span class="<%= entry.expense? ? 'text-danger' : 'text-success' %> fw-semibold"><%= entry.kind %> — <%= entry.amount %></span> —
        <%= entry.category.name %> —
        <span class="badge <%= entry.active? ? 'bg-success' : 'bg-secondary' %>"><%= entry.active? ? "ativa" : "inativa" %></span>
        <%= entry.end_date ? "até #{entry.end_date}" : "sem fim" %>
      </div>
      <div>
        <%= link_to "Editar", edit_recurring_entry_path(entry), class: "btn btn-sm btn-outline-secondary" %>
        <%= link_to "Remover", recurring_entry_path(entry), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "btn btn-sm btn-outline-danger" %>
      </div>
    </div>
  <% end %>
</div>

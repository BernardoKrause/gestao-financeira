<%= form_with model: recurring_entry do |f| %>
  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_field :description, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :amount, class: "form-label" %>
    <%= f.number_field :amount, step: 0.01, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :kind, class: "form-label" %>
    <%= f.select :kind, RecurringEntry.kinds.keys, {}, class: "form-select" %>
  </div>
  <div class="mb-3">
    <%= f.label :day_of_month, class: "form-label" %>
    <%= f.number_field :day_of_month, min: 1, max: 31, class: "form-control" %>
  </div>
  <div class="form-check mb-3">
    <%= f.check_box :active, class: "form-check-input" %>
    <%= f.label :active, class: "form-check-label" %>
  </div>
  <div class="mb-3">
    <%= f.label :start_date, class: "form-label" %>
    <%= f.date_field :start_date, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :installments, "Número de parcelas (deixe em branco pra recorrência sem fim)", class: "form-label" %>
    <%= f.number_field :installments, min: 1, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :category_id, "Categoria", class: "form-label" %>
    <%= f.collection_select :category_id, Category.order(:name), :id, :name, {}, class: "form-select" %>
  </div>
  <%= f.submit class: "btn btn-primary" %>
<% end %>

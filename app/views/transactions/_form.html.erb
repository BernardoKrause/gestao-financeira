<%= form_with model: transaction do |f| %>
  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_field :description, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :amount, class: "form-label" %>
    <%= f.number_field :amount, step: 0.01, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :kind, class: "form-label" %>
    <%= f.select :kind, Transaction.kinds.keys, {}, class: "form-select" %>
  </div>
  <div class="mb-3">
    <%= f.label :date, class: "form-label" %>
    <%= f.date_field :date, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :category_id, "Categoria", class: "form-label" %>
    <%= f.collection_select :category_id, Category.order(:name), :id, :name, {}, class: "form-select" %>
  </div>
  <%= f.submit class: "btn btn-primary" %>
<% end %>

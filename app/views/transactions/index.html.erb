<h1 class="mb-3">Lançamentos</h1>
<%= link_to "Novo lançamento", new_transaction_path, class: "btn btn-primary mb-3" %>

<table class="table table-striped bg-white align-middle">
  <thead>
    <tr>
      <th>Data</th>
      <th>Descrição</th>
      <th>Tipo</th>
      <th>Valor</th>
      <th>Categoria</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @transactions.each do |transaction| %>
      <tr>
        <td><%= transaction.date %></td>
        <td><%= transaction.description %></td>
        <td>
          <span class="badge <%= transaction.expense? ? 'bg-danger' : 'bg-success' %>">
            <%= transaction.expense? ? "Gasto" : "Receita" %>
          </span>
        </td>
        <td class="<%= transaction.expense? ? 'text-danger' : 'text-success' %> fw-semibold">
          <%= number_to_currency(transaction.amount, unit: "R$ ") %>
        </td>
        <td><%= transaction.category.name %></td>
        <td class="text-end">
          <%= link_to "Editar", edit_transaction_path(transaction), class: "btn btn-sm btn-outline-secondary" %>
          <%= link_to "Remover", transaction_path(transaction), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "btn btn-sm btn-outline-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

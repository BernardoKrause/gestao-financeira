<h1 class="mb-3">Lançamentos</h1>
<%= link_to "Novo lançamento", new_transaction_path, class: "btn btn-primary mb-3" %>
<div class="list-group">
  <% @transactions.each do |transaction| %>
    <div class="list-group-item d-flex justify-content-between align-items-center">
      <div>
        <%= transaction.date %> — <%= transaction.description %> —
        <span class="<%= transaction.expense? ? 'text-danger' : 'text-success' %> fw-semibold"><%= transaction.kind %> — <%= transaction.amount %></span> —
        <%= transaction.category.name %>
      </div>
      <div>
        <%= link_to "Editar", edit_transaction_path(transaction), class: "btn btn-sm btn-outline-secondary" %>
        <%= link_to "Remover", transaction_path(transaction), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "btn btn-sm btn-outline-danger" %>
      </div>
    </div>
  <% end %>
</div>

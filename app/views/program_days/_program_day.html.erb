<div class="rounded-lg border border-gray-200 bg-white p-4" data-sortable-id="<%= program_day.id %>" data-testid="program-day-<%= program_day.id %>">
  <div class="flex items-center justify-between gap-2">
    <span data-sortable-handle class="cursor-move text-gray-400">⠿</span>
    <div class="flex-1">
      <span class="font-semibold text-gray-900">Treino <%= program_day.label %></span>
      <span class="ml-2 text-sm text-gray-500"><%= program_day.title %></span>
    </div>
    <%= link_to "Remover dia", workout_program_program_day_path(workout_program, program_day), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "rounded border border-red-300 px-2 py-1 text-xs text-red-600 hover:bg-red-50" %>
  </div>
</div>

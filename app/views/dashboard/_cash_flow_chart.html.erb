<% subtitle = {
     confirmed: "Projeção não considera valores futuros",
     recurring: "Projeção considera apenas recorrências ativas",
     all: "Projeção considera recorrências e lançamentos avulsos futuros"
   }.fetch(@confidence || :recurring) %>

<% cash_flow_datasets = [
     {
       label: "Histórico Realizado",
       data: cash_flow_series[:historical],
       borderColor: "#10b981",
       backgroundColor: "rgba(16, 185, 129, 0.1)",
       fill: true,
       tension: 0.3,
       spanGaps: false
     },
     {
       label: "Projeção Futura",
       data: cash_flow_series[:projected],
       borderColor: "#64748b",
       borderDash: [ 5, 5 ],
       fill: false,
       tension: 0.3,
       spanGaps: false
     }
   ] %>

<div id="cash_flow_chart" class="mb-6 rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm">
  <h2 class="mb-1 text-sm font-semibold text-slate-700">Fluxo de caixa — <%= @current_month_label %></h2>
  <p class="mb-4 -mt-2 text-xs text-slate-500"><%= subtitle %></p>
  <div class="relative h-56">
    <canvas data-controller="chart"
            data-chart-labels-value="<%= cash_flow_series[:labels].to_json %>"
            data-chart-datasets-value="<%= cash_flow_datasets.to_json %>"></canvas>
  </div>
</div>

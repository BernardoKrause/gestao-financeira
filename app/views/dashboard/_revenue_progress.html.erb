<div class="mb-6 rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm">
  <div class="mb-2 flex items-center justify-between">
    <span class="text-sm font-semibold text-slate-700">Progresso de Arrecadação</span>
    <span class="text-xs font-medium text-slate-500">Total esperado: <%= number_to_currency(@receita_total_esperada_mes, unit: "R$ ") %></span>
  </div>

  <div class="flex h-3 w-full gap-0.5 overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-valuenow="<%= @pct_receita_confirmada %>" aria-valuemin="0" aria-valuemax="100" aria-label="Recebido este mês">
    <div style="width: <%= @pct_receita_confirmada %>%" class="h-full rounded-l-full bg-emerald-500"></div>
    <div style="width: <%= @pct_receita_pendente %>%" class="h-full bg-emerald-300/70"></div>
  </div>

  <div class="mt-3 flex items-center gap-4 text-xs text-slate-600">
    <div class="flex items-center gap-1.5">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
      <span>Recebido: <strong><%= number_to_currency(@receita_confirmada_mes, unit: "R$ ") %></strong></span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-300" aria-hidden="true"></span>
      <span>A Receber: <strong><%= number_to_currency(@receita_pendente_mes, unit: "R$ ") %></strong></span>
    </div>
  </div>
</div>

<h1 class="mb-4 text-2xl font-bold">Painel</h1>

<h2 class="mb-2 mt-2 text-xl font-semibold">Lançar</h2>
<div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
  <%= render "dashboard/quick_entry_form", kind: "expense", label: "Gasto",
        categories: current_user.categories.expense.order(:name),
        record: (@quick_entry_kind == "expense" ? @quick_entry_record : nil) %>

  <%= render "dashboard/quick_entry_form", kind: "income", label: "Receita",
        categories: current_user.categories.income.order(:name),
        record: (@quick_entry_kind == "income" ? @quick_entry_record : nil) %>
</div>

<div data-controller="dashboard-filter" data-dashboard-filter-url-value="<%= dashboard_confidence_path %>" class="mb-2 flex justify-end gap-1">
  <button type="button" data-dashboard-filter-target="button" data-dashboard-filter-level-param="confirmed"
          data-action="click->dashboard-filter#filter"
          class="rounded-full px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-100">
    Somente confirmado
  </button>
  <button type="button" data-dashboard-filter-target="button" data-dashboard-filter-level-param="recurring"
          data-action="click->dashboard-filter#filter"
          class="rounded-full bg-slate-900 px-3 py-1 text-xs font-medium text-white">
    Recorrências
  </button>
  <button type="button" data-dashboard-filter-target="button" data-dashboard-filter-level-param="all"
          data-action="click->dashboard-filter#filter"
          class="rounded-full px-3 py-1 text-xs font-medium text-slate-600 hover:bg-slate-100">
    Tudo
  </button>
</div>

<%= render "dashboard/financial_health_kpi" %>

<%= render "dashboard/revenue_progress" %>

<%= render "dashboard/cash_flow_chart" %>

<%= turbo_frame_tag "resumo_historico" do %>
  <%= form_with url: dashboard_path, method: :get, html: { class: "mb-6 flex flex-wrap items-end gap-3" } do %>
    <div>
      <%= label_tag :month, "Período (Resumo e Histórico)", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= select_tag :month, options_for_select(@month_options, @selected_month), class: "rounded border border-gray-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= label_tag :category_id, "Categoria", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= select_tag :category_id, options_for_select([ [ "Todas as categorias", "" ] ] + @category_options, @selected_category_id), class: "rounded border border-gray-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= submit_tag "Filtrar", class: "rounded border border-blue-600 px-4 py-2 text-sm text-blue-600 hover:bg-blue-50" %>
    </div>
  <% end %>

  <h2 class="mb-2 mt-2 text-xl font-semibold">Resumo — <%= @selected_month_label %></h2>
  <table class="mb-6 w-full bg-white text-sm">
    <tbody>
      <tr>
        <td class="border px-3 py-2">Receitas</td>
        <td class="border px-3 py-2 font-semibold text-green-600"><%= number_to_currency(@month_income_total, unit: "R$ ") %></td>
      </tr>
      <tr>
        <td class="border px-3 py-2">Gastos</td>
        <td class="border px-3 py-2 font-semibold text-red-600"><%= number_to_currency(@month_expense_total, unit: "R$ ") %></td>
      </tr>
    </tbody>
  </table>

  <h2 class="mb-2 mt-2 text-xl font-semibold">Histórico — <%= @selected_month_label %></h2>

  <div class="grid gap-3 md:hidden" data-testid="history-cards">
    <% @transactions.each do |transaction| %>
      <%= render "history_row", transaction: transaction, format: :card %>
    <% end %>
  </div>

  <table class="hidden w-full bg-white text-sm md:table" data-testid="history-table">
    <thead>
      <tr>
        <th scope="col" class="border border-slate-200 px-3 py-2 text-left">Data</th>
        <th scope="col" class="border border-slate-200 px-3 py-2 text-left">Descrição</th>
        <th scope="col" class="border border-slate-200 px-3 py-2 text-left">Categoria</th>
        <th scope="col" class="border border-slate-200 px-3 py-2 text-left">Status</th>
        <th scope="col" class="border border-slate-200 px-3 py-2 text-left">Valor</th>
      </tr>
    </thead>
    <tbody>
      <% @transactions.each do |transaction| %>
        <%= render "history_row", transaction: transaction, format: :table %>
      <% end %>
    </tbody>
  </table>
<% end %>

<h1>Painel</h1>

<h2>Saldo</h2>
<table>
  <tbody>
    <tr>
      <td>Saldo atual</td>
      <td><%= number_to_currency(@current_balance, unit: "R$ ") %></td>
    </tr>
    <tr>
      <td>Previsto até o fim do mês</td>
      <td><%= number_to_currency(@projected_balance, unit: "R$ ") %></td>
    </tr>
  </tbody>
</table>

<details<%= " open" if @setting&.errors&.any? %> class="setting-edit">
  <summary>Editar saldo inicial</summary>

  <%= form_with model: @setting, url: setting_path, method: :patch do |f| %>
    <% if @setting.errors.any? %>
      <div class="error-messages">
        <ul>
          <% @setting.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :initial_balance, "Saldo inicial" %>
      <%= f.number_field :initial_balance, step: 0.01 %>
    </div>

    <%= f.submit "Salvar" %>
  <% end %>
</details>

<h2>Resumo do mês</h2>
<table>
  <tbody>
    <tr>
      <td>Receitas do mês</td>
      <td><%= number_to_currency(@month_income_total, unit: "R$ ") %></td>
    </tr>
    <tr>
      <td>Gastos do mês</td>
      <td><%= number_to_currency(@month_expense_total, unit: "R$ ") %></td>
    </tr>
  </tbody>
</table>

<h2>Lançar</h2>
<div class="quick-entries">
  <%= render "dashboard/quick_entry_form", kind: "expense", label: "Gasto",
        categories: Category.expense.order(:name),
        record: (@quick_entry_kind == "expense" ? @quick_entry_record : nil) %>

  <%= render "dashboard/quick_entry_form", kind: "income", label: "Receita",
        categories: Category.income.order(:name),
        record: (@quick_entry_kind == "income" ? @quick_entry_record : nil) %>
</div>

<h2>Lançamentos do mês</h2>
<ul>
  <% @transactions.each do |transaction| %>
    <li>
      <%= transaction.date %> — <%= transaction.description %> — <%= transaction.kind %> —
      <%= number_to_currency(transaction.amount, unit: "R$ ") %> —
      <%= transaction.category.name %>
    </li>
  <% end %>
</ul>

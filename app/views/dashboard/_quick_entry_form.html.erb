<details<%= " open" if record&.errors&.any? %> class="quick-entry quick-entry--<%= kind %>">
  <summary><%= label %></summary>

  <%= form_with url: quick_entries_path, method: :post do %>
    <% if record&.errors&.any? %>
      <div class="error-messages">
        <ul>
          <% record.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= hidden_field_tag :kind, kind, id: "kind_#{kind}" %>

    <div>
      <%= label_tag "description_#{kind}", "Descrição" %>
      <%= text_field_tag :description, record&.description, id: "description_#{kind}" %>
    </div>

    <div>
      <%= label_tag "amount_#{kind}", "Valor" %>
      <%= number_field_tag :amount, record&.amount, step: 0.01, id: "amount_#{kind}" %>
    </div>

    <div>
      <%= label_tag "category_id_#{kind}", "Categoria" %>
      <%= select_tag :category_id, options_from_collection_for_select(categories, :id, :name, record&.category_id), id: "category_id_#{kind}" %>
    </div>

    <div class="quick-entry-fixed-toggle">
      <%= check_box_tag :fixed, "1", record.is_a?(RecurringEntry), class: "fixed-toggle", id: "fixed_#{kind}" %>
      <%= label_tag "fixed_#{kind}", "Fixo (recorrente)" %>
    </div>

    <div class="quick-entry-field quick-entry-field--avulso">
      <%= label_tag "date_#{kind}", "Data" %>
      <%= date_field_tag :date, (record.is_a?(Transaction) ? record.date : Date.current), id: "date_#{kind}" %>
    </div>

    <% is_recurring = record.is_a?(RecurringEntry)
       is_parcelado = is_recurring && record.installments.present? %>

    <div class="quick-entry-field quick-entry-field--fixo quick-entry-recurring-options">
      <div class="quick-entry-parcelado-toggle">
        <%= check_box_tag :parcelado, "1", is_parcelado, class: "parcelado-toggle", id: "parcelado_#{kind}" %>
        <%= label_tag "parcelado_#{kind}", "Parcelado (tem fim)?" %>
      </div>

      <div class="quick-entry-subfield quick-entry-subfield--sem-parcelas">
        <%= label_tag "day_of_month_#{kind}", "Dia do mês" %>
        <%= number_field_tag :day_of_month, (is_recurring && !is_parcelado ? record.day_of_month : nil), min: 1, max: 31, id: "day_of_month_#{kind}" %>
      </div>

      <div class="quick-entry-subfield quick-entry-subfield--parcelado">
        <div>
          <%= label_tag "start_date_#{kind}", "Data de início" %>
          <%= date_field_tag :start_date, (is_parcelado ? record.start_date : Date.current), id: "start_date_#{kind}" %>
        </div>
        <div>
          <%= label_tag "installments_#{kind}", "Número de parcelas" %>
          <%= number_field_tag :installments, (is_parcelado ? record.installments : nil), min: 1, id: "installments_#{kind}" %>
        </div>
      </div>
    </div>

    <%= submit_tag label %>
  <% end %>
</details>

# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Example of extracting secrets from 1password (or another compatible pw manager)
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
# RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})

# Example of extracting secrets from Rails credentials
# KAMAL_REGISTRY_PASSWORD=$(rails credentials:fetch kamal.registry_password)

# Use a GITHUB_TOKEN if private repositories are needed for the image
# GITHUB_TOKEN=$(gh config get -h github.com oauth_token)

# Grab the registry password from ENV
# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Grab the GHCR access token from ENV (a GitHub PAT with `write:packages` scope).
# Export KAMAL_REGISTRY_PASSWORD in your shell before running `bin/kamal setup`/`deploy`.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# config/master.key doesn't exist — bypassing credentials.yml.enc entirely via
# SECRET_KEY_BASE instead. Never commit .env.production.local (already gitignored).
SECRET_KEY_BASE=$(grep '^SECRET_KEY_BASE=' .env.production.local | cut -d '=' -f2-)

# Postgres accessory password, reused as the app's DB password (same value, two
# env var names — see accessories.db and env.secret in config/deploy.yml).
POSTGRES_PASSWORD=$(grep '^POSTGRES_PASSWORD=' .env.production.local | cut -d '=' -f2-)
GESTAO_FINANCEIRA_MVP_DATABASE_PASSWORD=$POSTGRES_PASSWORD
